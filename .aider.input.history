# 2026-08-28 07:25:02.504503
+Get-ChildItem -Path "app" -Recurse -Filter "page.tsx" | ForEach-Object {
+    $relPath = $_.FullName -replace [regex]::Escape((Get-Location).Path + "\"), ""
+    $url = $_.DirectoryName -replace [regex]::Escape((Get-Location).Path + "\app"), "" -replace "\\", "/"
+    if ($url -eq "") { $url = "/" }
+    
+    # อ่านบรรทัด import ในแต่ละ page เพื่อดูว่าดึง component ไหนมาใช้บ้าง
+    $imports = Get-Content $_.FullName | Where-Object { $_ -match "import .* from '@?/components" } | ForEach-Object { $_.Trim() }
+    
+    [PSCustomObject]@{
+        URL = "http://localhost:3000$url"
+        FilePath = $relPath
+        UsedComponents = ($imports -join " | ")
+    }
+} | Format-List

